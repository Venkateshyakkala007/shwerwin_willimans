NODE_ENV=development
AUTH_ADAPTER=local
API_PORT=4000
API_ALLOWED_ORIGIN=http://localhost:3000
BACKEND_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Local demo only. Set a different password outside disposable environments.
LOCAL_AUTH_PASSWORD=cover-local-demo
DATABASE_URL=postgresql://cover_app:cover_dev@localhost:5432/cover_codebase
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Local synthetic runtime only; production rejects this mode.
DEMO_MODE=true
